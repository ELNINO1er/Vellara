# Variables SERVEUR (fonctions /api) — ne jamais les préfixer VITE_ (elles seraient publiées dans le JavaScript).
# En local : copier ce fichier en .env.local. Sur Vercel : Settings › Environment Variables.
#
# Empreinte du mot de passe :
#   node -e "console.log(require('crypto').createHash('sha256').update('MOT_DE_PASSE').digest('hex'))"
# Clé de session (aléatoire, 32 caractères minimum) :
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
ADMIN_EMAIL=admin@exemple.fr
ADMIN_PASSWORD_SHA256=
SESSION_SECRET=
